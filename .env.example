# Copy the API section to apps/api/.env and fill in (dotenv loads it from there).
# The web app needs no env file in dev — the Vite proxy serves /api same-origin.
# Never commit the real .env.

# --- API (apps/api) ---
NODE_ENV=development
# API port — 3001 so it doesn't clash with mi7rab's api on 3000.
PORT=3001

# Postgres + Redis (host ports match docker-compose.yml; chosen to avoid clashing
# with mi7rab's 5433/6379 and other local services).
DATABASE_URL=postgres://afya:afya@localhost:5435/afya
REDIS_URL=redis://localhost:6380

# Better Auth (generate a strong secret: `openssl rand -base64 32`)
BETTER_AUTH_SECRET=replace-with-a-32+-char-random-secret
BETTER_AUTH_URL=http://localhost:3001

# Comma-separated allowlist of browser origins (CORS allowlist + CSRF trusted origins).
# The web dev server runs on 5174 (5173 is mi7rab's).
CORS_ORIGINS=http://localhost:5174

# --- Web (apps/web, Vite — only VITE_* vars reach the browser) ---
# Leave empty in dev: the Vite proxy serves /api same-origin so cookies "just work".
VITE_API_URL=
